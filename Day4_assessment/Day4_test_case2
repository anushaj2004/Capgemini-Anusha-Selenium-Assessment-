public class Day4_test_case2 {

	public static void main(String[] args) throws InterruptedException {
		// TODO Auto-generated method stub
		WebDriver driver= new ChromeDriver();
	     driver.manage().window().maximize();
	     driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
	     driver.get("https://www.zomato.com/bangalore/delivery");
	     driver.findElement(By.xpath("//button[text()='Log in']")).click();
	     WebElement login = driver.findElement(By.id("auth-login-ui"));
	     driver.switchTo().frame(login);
	     driver.findElement(By.xpath("//input[@type='number']")).sendKeys("9353487555");
	     driver.switchTo().defaultContent();
	    WebElement text = driver.findElement(By.xpath("//div[text()='Nightlife']"));
	    if(text.getText().contains("Nightlife"))
	    {
	    	System.out.println("control is in main page");
	    }
        else
        {
        	System.out.println("control is not in main page");
        }
	}

